<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.dbonkowska</groupId>
        <artifactId>dscribe</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>labs</artifactId>

    <properties>
        <maven.compiler.source>26</maven.compiler.source>
        <maven.compiler.target>26</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.github.dbonkowska</groupId>
            <artifactId>llm-core</artifactId>
            <version>1.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-csv</artifactId>
            <version>1.12.0</version>
        </dependency>
        <!--
            BPE tokenizer for OpenAI encodings — the JVM's answer to tiktoken. Used to measure a
            prompt locally before an external judge is asked to, so an over-long one costs a model
            iteration instead of a request budget. Zero transitive dependencies.

            1.1.0 is July 2024 and the newest published: `o200k_harmony`, the encoding the current
            model family actually uses, exists only as unmerged pull requests upstream. We measure
            with `o200k_base`, which shares the same base merge table and differs in special tokens
            for the chat envelope — which a bare prompt string never carries. The judge stays the
            authority; this is a cheap guard, not a prediction of its arithmetic.
        -->
        <dependency>
            <groupId>com.knuddels</groupId>
            <artifactId>jtokkit</artifactId>
            <version>1.1.0</version>
        </dependency>

        <!--
            Binds a lesson's task.properties straight to a record, so each new lesson
            costs one record declaration instead of a hand-written parse method.
            Same Jackson version as llm-core's databind.
        -->
        <dependency>
            <groupId>tools.jackson.dataformat</groupId>
            <artifactId>jackson-dataformat-properties</artifactId>
            <version>3.2.0</version>
        </dependency>

        <!--
            The SLF4J provider. Being the application, labs is what decides where llm-core's
            events go; runtime scope keeps the provider off the compile classpath so nothing
            can import it by mistake. Without a provider, SLF4J discards every event and warns.
        -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>2.0.17</version>
            <scope>runtime</scope>
        </dependency>

        <!--
            JUnit 5. The aggregate artifact: pulls in junit-jupiter-api (annotations and
            assertions), junit-jupiter-params (@ParameterizedTest) and junit-jupiter-engine
            (the runtime Surefire discovers tests with). One entry is enough.
        -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>6.1.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <!-- No default mainClass: every lesson is picked per run with -Dexec.mainClass -->
            </plugin>


        </plugins>
    </build>

</project>
